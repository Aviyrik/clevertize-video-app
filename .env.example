# Clevertize Script Intelligence & Video Generation Platform
# Environment Configuration Template
# Copy this file to .env and configure with your actual keys.

# ============================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================
# Connect any standard PostgreSQL database (Neon, Supabase, Render, Railway, or local)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# If DATABASE_URL is left empty, the application automatically falls back to local atomic JSON files.
DATABASE_URL=

# ============================================================
# AI MODEL PROVIDER (Required for script intelligence)
# ============================================================
# Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================
# VIDEO RENDERING ENGINE (Optional, for video rendering)
# ============================================================
# Magnific AI API key (https://magnific.ai/)
MAGNIFIC_API_KEY=
# One flow per aspect ratio x product image x logo image. The server picks the flow from what the
# user uploaded; leave these unset to use the built-in IDs shown here.
FLOW_916_PRODUCT_LOGO=0MQyTfWvQD
FLOW_916_PRODUCT_NOLOGO=rl5XxtcFH6
FLOW_916_NOPRODUCT_LOGO=TeYJVNR8Ta
FLOW_916_NOPRODUCT_NOLOGO=kLqd16BU1G
FLOW_169_PRODUCT_LOGO=MXcPDCmYv9
FLOW_169_PRODUCT_NOLOGO=Pi7b42C8Sz
FLOW_169_NOPRODUCT_LOGO=wPlQ7EIQVN
FLOW_169_NOPRODUCT_NOLOGO=jSkvLD0Vkf
FLOW_11_PRODUCT_LOGO=79RyJALGdZ
FLOW_11_PRODUCT_NOLOGO=jUySLD0Vkf
FLOW_11_NOPRODUCT_LOGO=8aQhIrUjeZ
FLOW_11_NOPRODUCT_NOLOGO=iGcG3uKdQH

# ============================================================
# VIDEO STORAGE (Optional, keeps finished videos permanently)
# ============================================================
# Magnific video links expire. With these set, each finished video is copied into Supabase Storage
# and My Projects keeps that permanent link. Create a PUBLIC bucket (default name "videos") first.
# The service role key is a server-side secret: never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=videos
# Optional: extra exact hostnames finished videos may be downloaded from (comma-separated), if Magnific
# starts delivering from a new CDN host. Magnific's pikaso.cdnpk.net and your Supabase bucket are built in.
VIDEO_HOSTS_EXTRA=

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# FEEDBACK & ISSUE REPORTING CONFIGURATION (FormSubmit)
# ============================================================
# FormSubmit submission endpoint (default is activated viki@clevertize.com)
FEEDBACK_FORM_ENDPOINT=https://formsubmit.co/viki@clevertize.com
# Destination email address of the CleverCut team
FEEDBACK_EMAIL_TO=viki@clevertize.com

# ============================================================
# OUTBOUND TRANSACTIONAL EMAIL (Resend)
# ============================================================
# Resend API Key (https://resend.com/api-keys)
RESEND_API_KEY=
# Configurable sender address (default testing sender onboarding@resend.dev)
AUTH_EMAIL_FROM=onboarding@resend.dev
# Application base URL for links in emails (verification, password reset). Set it in production, e.g.
# https://clevercut.app. Without it the request's Host header is used (never X-Forwarded-Host).
APP_BASE_URL=http://localhost:3000
# Login requires a verified email address: on by default when NODE_ENV=production, off otherwise.
# true/false overrides it (e.g. true to test enforcement locally with a Resend key).
EMAIL_VERIFICATION_REQUIRED=



