# Clevertize Script Intelligence & Video Generation Platform
# Environment Configuration Template
# Copy this file to .env and provide your actual API keys.

# Anthropic Claude API (Required for creative intelligence & script generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Magnific AI Flows API (Required for video generation)
MAGNIFIC_API_KEY=your_magnific_api_key_here
MAGNIFIC_FLOW_ID=0MQyTfWvQD

# Server Configuration
PORT=3001

# Dashboard Access Control (Optional: leave empty to disable authentication)
DASHBOARD_PASSWORD=
