# Clevertize Script Intelligence & Video Generation Platform
# Environment Configuration Template
# Copy this file to .env and configure with your actual keys.

# ============================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================
# Connect any standard PostgreSQL database (Neon, Supabase, Render, Railway, or local)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# If DATABASE_URL is left empty, the application automatically falls back to local atomic JSON files.
DATABASE_URL=

# ============================================================
# AI MODEL PROVIDER (Required for script intelligence)
# ============================================================
# Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================
# VIDEO RENDERING ENGINE (Optional, for video rendering)
# ============================================================
# Magnific AI API key (https://magnific.ai/)
MAGNIFIC_API_KEY=
# One flow per aspect ratio x product image x logo image. The server picks the flow from what the
# user uploaded; leave these unset to use the built-in IDs shown here.
FLOW_916_PRODUCT_LOGO=0MQyTfWvQD
FLOW_916_PRODUCT_NOLOGO=rl5XxtcFH6
FLOW_916_NOPRODUCT_LOGO=TeYJVNR8Ta
FLOW_916_NOPRODUCT_NOLOGO=kLqd16BU1G
FLOW_169_PRODUCT_LOGO=MXcPDCmYv9
FLOW_169_PRODUCT_NOLOGO=Pi7b42C8Sz
FLOW_169_NOPRODUCT_LOGO=wPlQ7EIQVN
FLOW_169_NOPRODUCT_NOLOGO=jSkvLD0Vkf
FLOW_11_PRODUCT_LOGO=79RyJALGdZ
FLOW_11_PRODUCT_NOLOGO=jUySLD0Vkf
FLOW_11_NOPRODUCT_LOGO=8aQhIrUjeZ
FLOW_11_NOPRODUCT_NOLOGO=iGcG3uKdQH

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3000
NODE_ENV=development

